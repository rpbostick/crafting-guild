# The replay bench, resumed at login after a crash or reboot. Its command lives in the file named by
# WS_BENCH_AUTOSTART_CMD (private: which projects and arms); the bench resumes where it stopped,
# waits outside WS_BENCH_HOURS, and exits when every run is done.
[Unit]
Description=Crafting Guild replay bench (resumes after a reboot)
After=default.target

[Service]
ExecStart=%h/crafting-guild/scripts/bench-autostart.sh
# A service started at login does not get a shell's PATH: without this, dispatch cannot find
# opencode and the merge gate cannot find npm (2026-10-29: all 48 night runs died this way).
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
