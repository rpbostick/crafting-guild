# Bike Weather sharing, steps 3 to 5 (ratings-share.md). bw-share-settings is dispatched by hand first so it builds beside the Worker.
# Run with: bin/ws --project bike-weather chain plans/bike-weather/ratings-share.queue   (under run_in_background)
ratings-worker     plans/bike-weather/task-ratings-worker.md --budget 10
bw-share-settings  plans/bike-weather/task-bw-share-settings.md gate --budget 5
bw-share-upload    plans/bike-weather/task-bw-share-upload.md --budget 5
bw-heat-indexes    plans/bike-weather/task-bw-heat-indexes.md gate --budget 6
