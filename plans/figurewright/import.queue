# figurewright import build, run by `bin/ws --project figurewright chain plans/figurewright/import.queue`.
# <name> <task> [gate] [dispatch flags]. gate = the operator sees it before the merge.
fw-importer        plans/figurewright/task-fw-29-importer.md
fw-import-warp     plans/figurewright/task-fw-30-import-warp.md
fw-render-pins     plans/figurewright/task-fw-33-render-pins.md --allow "Bash(npm run renders:*)"
fw-import-layering plans/figurewright/task-fw-31-import-layering.md gate
fw-shoulder-options plans/figurewright/task-fw-34-shoulder-options.md gate --timeout 150m
fw-shoulder-armpit plans/figurewright/task-fw-35-shoulder-armpit.md gate --timeout 180m
fw-shoulders-build plans/figurewright/task-fw-36-shoulders-build-2.md gate --timeout 180m --allow "Bash(npm run renders:*)"
fw-found-art       plans/figurewright/task-fw-32-found-art.md gate --timeout 180m
